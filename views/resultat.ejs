<%- include('partials/header') %>

<!-- Header du Rapport -->
<div class="card result-header-card">
  <div class="result-top">
    <div class="score-circle-container">
      <div class="score-circle score-level-<%= report.globalScore >= 70 ? 'high' : (report.globalScore >= 40 ? 'med' : 'low') %>">
        <span class="score-value"><%= report.globalScore %></span>
        <span class="score-max">/100</span>
      </div>
      <span class="score-label">Score ALODO MPME</span>
    </div>

    <div class="result-summary">
      <span class="badge-profile"><%= report.profileTitle %></span>
      <h1 class="report-title">Synthèse de Maturité</h1>
      <p class="global-rec"><%= report.globalRecommendation %></p>
    </div>
  </div>
</div>

<!-- Alertes Prioritaires (Règles d'Or) si présentes -->
<% if (report.goldenAlerts && report.goldenAlerts.length > 0) { %>
  <div class="section-block">
    <h2 class="section-heading text-danger">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: text-bottom; margin-right: 8px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      Alertes Prioritaires (Lignes Rouges de Structuration)
    </h2>
    <div class="alerts-grid">
      <% report.goldenAlerts.forEach(alert => { %>
        <div class="alert-card alert-<%= alert.level.toLowerCase() %>">
          <div class="alert-header">
            <span class="alert-level"><%= alert.level %></span>
            <h3 class="alert-title"><%= alert.title %></h3>
          </div>
          <p class="alert-message"><%= alert.message %></p>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<!-- Scores par dimension -->
<div class="section-block">
  <h2 class="section-heading">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: text-bottom; margin-right: 8px;"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
    Détail des Scores par Dimension
  </h2>
  <div class="dimensions-grid">
    <% Object.keys(report.dimensions).forEach(dimKey => { 
        const dim = report.dimensions[dimKey];
    %>
      <div class="dimension-card">
        <div class="dim-header">
          <span class="dim-title"><%= dim.label %></span>
          <span class="dim-score"><%= dim.score %>%</span>
        </div>
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" style="width: <%= dim.score %>%;"></div>
        </div>
        <div class="dim-footer">
          <span>Points obtenus : <%= dim.obtained %> / <%= dim.max %> pts</span>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<!-- Points Forts & Axes d'Amélioration -->
<div class="grid-2-cols section-block">
  
  <!-- Points Forts -->
  <div class="card card-success">
    <h2 class="section-subheading text-success">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: text-bottom; margin-right: 6px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      Points Forts Identifiés (<%= report.pointsForts.length %>)
    </h2>
    <% if (report.pointsForts.length === 0) { %>
      <p class="empty-state">Aucun point fort majeur identifié sur ces dimensions.</p>
    <% } else { %>
      <ul class="insights-list">
        <% report.pointsForts.forEach(item => { %>
          <li class="insight-item">
            <span class="insight-dim"><%= item.dimension %></span>
            <strong><%= item.title %></strong>
            <p class="insight-detail"><%= item.detail %></p>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <!-- Axes d'Amélioration -->
  <div class="card card-warning">
    <h2 class="section-subheading text-warning">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: text-bottom; margin-right: 6px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      Axes d'Amélioration Prioritaires (<%= report.axesAmelioration.length %>)
    </h2>
    <% if (report.axesAmelioration.length === 0) { %>
      <p class="empty-state">Excellente structuration ! Aucun axe d'amélioration critique.</p>
    <% } else { %>
      <ul class="insights-list">
        <% report.axesAmelioration.forEach(item => { %>
          <li class="insight-item">
            <span class="insight-dim"><%= item.dimension %></span>
            <strong><%= item.title %></strong>
            <p class="insight-detail">Statut actuel : <%= item.detail %></p>
            <p class="insight-rec">💡 <em><%= item.recommendation %></em></p>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

</div>

<!-- Actions de fin -->
<div class="action-bar align-center section-block">
  <a href="/diagnostic/reset" class="btn btn-secondary">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
    Recommencer le diagnostic
  </a>
</div>

<%- include('partials/footer') %>
